# Local development database credentials (FND-002c). DEVELOPMENT ONLY.
#
# Copy this file to `.env`, which is git-ignored:
#
#     cp .env.example .env
#
# The password below is a placeholder, not a secret. It is safe to commit precisely because it
# grants access to nothing but a loopback-bound container holding disposable local data. Never put
# a real credential in this file — `.env` exists for that, and it is never committed.

POSTGRES_USER=jaya_dev
POSTGRES_PASSWORD=jaya_local_dev_only
POSTGRES_DB=jaya_dev
POSTGRES_PORT=5432

# The runner reads this and nothing else. It must match the values above.
DATABASE_URL=postgres://jaya_dev:jaya_local_dev_only@127.0.0.1:5432/jaya_dev
