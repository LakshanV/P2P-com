{
  "name": "jaya",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JAYA — AI-native universal P2P commerce platform. Platform substrate: pinned toolchain, architectural boundary enforcement, and the database migration contract (FND-001a, FND-001b, FND-002a).",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run check:boundaries && npm run check:migrations && npm test",
    "check:boundaries": "node platform/checks/cli.ts",
    "postbuild": "node dist/checks/cli.js --quiet && node dist/db/cli.js --quiet",
    "check:migrations": "node platform/db/cli.ts",
    "db:status": "node platform/db/migrate-cli.ts status",
    "db:migrate": "node platform/db/migrate-cli.ts up",
    "db:rollback": "node platform/db/migrate-cli.ts rollback",
    "test:integration": "node --test \"tests/integration/**/*.integration.ts\"",
    "db:up": "node platform/db/provision-cli.ts up",
    "db:ready": "node platform/db/provision-cli.ts ready",
    "db:down": "node platform/db/provision-cli.ts down",
    "db:reset": "node platform/db/provision-cli.ts reset",
    "db:destroy": "node platform/db/provision-cli.ts destroy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.15.5",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
